# Copy this file to ".env" and fill in the values you need.
# Never commit the real ".env" file — it is already in .gitignore.
#
# You do NOT need any API keys to run data collection, feature
# generation, model training, backtesting, or paper trading. Those all
# use Binance's PUBLIC market data endpoints, which require no account.
#
# API keys are only needed for Phase 17 (testnet) and Phase 18 (live
# trading), which are disabled by default. See docs/REAL_TRADING.md.

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# When running via Docker Compose, "postgres" is the service name and
# resolves automatically. When running Python directly on your host
# (no Docker), change this to "localhost".
DATABASE_URL=postgresql+psycopg2://crypto_ai:crypto_ai@localhost:5432/crypto_ai

# Optional: use a local SQLite file instead of Postgres for quick
# experiments (e.g. running the test suite). Leave unset for normal use.
# DATABASE_URL=sqlite:///./data_store/crypto_ai.db

# ---------------------------------------------------------------------
# System mode — see docs/BEGINNER_GUIDE.md
#   RESEARCH -> PAPER -> TESTNET -> LIVE
# ---------------------------------------------------------------------
MODE=RESEARCH

# Master safety switches. Both must be explicitly flipped to enable
# real order placement, in addition to every other gate documented in
# docs/REAL_TRADING.md.
TRADING_ENABLED=false
REAL_TRADING_ENABLED=false
EMERGENCY_STOP=false

# ---------------------------------------------------------------------
# Binance API credentials (OPTIONAL — only needed for testnet/live)
# ---------------------------------------------------------------------
# Use a SEPARATE key pair for testnet vs. live. Never enable
# "withdrawals" on either key.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ---------------------------------------------------------------------
# Local LLM (OPTIONAL — the system works with LLM_ENABLED=false)
# ---------------------------------------------------------------------
LLM_ENABLED=true
LLM_PROVIDER=ollama
# From inside Docker on Windows/Mac, use host.docker.internal instead
# of localhost to reach a host-installed Ollama/LM Studio server.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------
# Notifications (OPTIONAL)
# ---------------------------------------------------------------------
NOTIFY_TELEGRAM_ENABLED=false
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Resource limits — see docs/TROUBLESHOOTING.md and `run.py system-check`
# ---------------------------------------------------------------------
MAX_WORKERS=2
BATCH_SIZE=256
